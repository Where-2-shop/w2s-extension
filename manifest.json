{
  "manifest_version": 3,
  "name": "Where2Shop",
  "short_name": "W2S",
  "version": "1.1.6",
  "description": "Compare Coles, Woolworths & Aldi — auto-fill your cart at the cheapest store.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://where2shop.com.au/*",
    "https://www.woolworths.com.au/*",
    "https://www.coles.com.au/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://where2shop.com.au/*"
      ],
      "js": [
        "content/where2shop.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.woolworths.com.au/*"
      ],
      "js": [
        "content/woolworths.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.coles.com.au/*"
      ],
      "js": [
        "content/coles.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Where2Shop",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
